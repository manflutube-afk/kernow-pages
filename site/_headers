# Cloudflare Pages reads this file at deploy time and applies the headers
# below to matching paths. Rules are matched top to bottom; all matching
# rules apply.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# 'unsafe-inline' in style-src is there for the handful of inline style="..."
# attributes in the HTML. Strip those and you can drop it.

# CSS and JS aren't fingerprinted, so keep the cache short enough that an edit
# shows up the same day without a hard refresh.
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Images change far less often.
/assets/*
  Cache-Control: public, max-age=604800

# The form endpoint must never be cached.
/api/*
  Cache-Control: no-store
